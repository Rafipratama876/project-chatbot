NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ai_channel_letters

REDIS_HOST=localhost
REDIS_PORT=6380

# The four bounded LLM nodes. Off by default: the 56 rules run either way, and
# the two decision points escalate rather than guess. Uses the same
# OPENAI_API_KEY as image enhancement below — one AI provider for the whole app.
LLM_ENABLED=false
LLM_MODEL=gpt-5.1
LLM_MIN_CONFIDENCE=0.75

# pgvector stores only. 'openai' or 'none' — 'none' falls back to Postgres
# full-text search, which is worse at paraphrase and fine for most vendor lookups.
EMBEDDING_PROVIDER=none
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

PROOF_DIR=./storage/proofs

# The one AI credential this app uses: the four LLM nodes above, image
# enhancement below, and embeddings (when EMBEDDING_PROVIDER=openai).
OPENAI_API_KEY=

# The optional generative pass over the empty ground behind the sign.
# Off by default. It never touches the sign or the customer's photograph —
# every protected pixel is restored from the deterministic render and verified
# byte for byte, and the base render is always kept beside the enhanced one.
ENHANCE_ENABLED=false
ENHANCE_MODEL=gpt-image-1
# Untouchable margin around the sign, in pixels.
ENHANCE_MARGIN_PX=12

# Turning ENHANCE_ENABLED on adds one illustrative concept scene per render
# (a generated setting with the real sign composited and verified onto it).
# It costs one image generation per render. The proof panels are unaffected.
