NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ai_channel_letters

REDIS_HOST=localhost
REDIS_PORT=6380

# The four bounded LLM nodes. Off by default: the 56 rules run either way, and
# the two decision points escalate rather than guess.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
CL_MODEL=claude-opus-5
CL_MIN_CONFIDENCE=0.75

# pgvector stores only. Anthropic has no embeddings endpoint; 'voyage' or 'none'.
EMBEDDING_PROVIDER=none
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIMENSIONS=1024

PROOF_DIR=./storage/proofs

# Optional post-three.js photorealism pass. The three.js PNG is the authoritative
# edit input; enabling this adds one OpenAI image call per proof panel.
AI_RENDER_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-5.1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TIMEOUT_MS=180000
